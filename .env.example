# Optional, deployed separately from the static Family Bloom web app. Only HTTPS URL, no secrets.
EXPO_PUBLIC_MOMENT_MEDIA_API_URL=https://vercelfamilybloommedia.vercel.app

# R3R3D1: local, temporary diagnostic observer. Set 0 to disable after stable.
EXPO_PUBLIC_FB_SESSION_DIAGNOSTICS=1

# R16R10 Production: ALL Firebase accounts, shared with Web.
# Copy .env.main.example to .env OR let Signing BAT prompt for Gateway URL once.
# These URLs are public; NEVER include private Cloudinary/Firebase Admin credentials.
EXPO_PUBLIC_SINGLE_SESSION_ENABLED=1
EXPO_PUBLIC_SINGLE_SESSION_API_URL=https://REPLACE_WITH_YOUR_GATEWAY_DOMAIN/api/session
EXPO_PUBLIC_SINGLE_SESSION_ANDROID_PREVIEW=0

# Experimental private draft sync; keep disabled until bundle and live API gates pass.
EXPO_PUBLIC_FAMILY_EDITOR_DRAFTS_ENABLED=0

# Opt-in only until live rich publication and Android bundle gates pass.
EXPO_PUBLIC_FAMILY_FIELD_EDITOR_ENABLED=0

# R36 DEV only: private text-only Moment drafts; server must enable both draft flags.
EXPO_PUBLIC_FAMILY_FORM_DRAFTS_ENABLED=0
# R38 private image draft transport; also requires server flags.
EXPO_PUBLIC_FAMILY_FORM_IMAGES_ENABLED=0

# Experimental opt-in local Moment recovery; keep disabled in production.
EXPO_PUBLIC_FAMILY_LOCAL_MOMENT_RECOVERY_ENABLED=0

# Experimental private MP4 drafts, requires form image support. Maximum 2 MiB per file.
EXPO_PUBLIC_FAMILY_FORM_VIDEOS_ENABLED=0

# R43: private direct video pilot, exact test UID only; never enable before live validation.
EXPO_PUBLIC_FAMILY_FORM_DIRECT_VIDEO_ENABLED=0
EXPO_PUBLIC_FAMILY_FORM_DIRECT_VIDEO_TEST_UID=

EXPO_PUBLIC_FAMILY_MOMENT_PUBLISH_RECOVERY_ENABLED=0
