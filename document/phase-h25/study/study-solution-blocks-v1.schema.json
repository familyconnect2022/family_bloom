{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familybloom.local/schemas/study-solution-blocks-v1.json",
  "title": "Family Bloom — ordered study solution blocks (v1, backwards compatible)",
  "description": "This schema validates blocks[] only. For Firestore keep the existing question/answer document fields; do not add schemaVersion at root without modifying rules.",
  "type": "array",
  "minItems": 1,
  "maxItems": 24,
  "items": {
    "oneOf": [
      {
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "text"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          }
        }
      },
      {
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "formula"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "relationBefore": {
            "type": "string",
            "enum": [
              "none",
              "implies",
              "iff",
              "equals"
            ]
          },
          "formulaTemplate": {
            "type": "string"
          },
          "formulaFields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "formulaParts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "literal",
                    "template"
                  ]
                },
                "syntax": {
                  "enum": [
                    "plain",
                    "chemistry"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "templateId": {
                  "type": "string"
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    ]
  }
}
