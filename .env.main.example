# Family Bloom Android Production (public settings, not credentials)
# Fill Gateway hostname once, keep this .env OUT of GitHub.
EXPO_PUBLIC_MOMENT_MEDIA_API_URL=https://vercelfamilybloommedia.vercel.app
EXPO_PUBLIC_CHESS_SOCKET_URL=https://render-chess-xiangqi.onrender.com
EXPO_PUBLIC_SINGLE_SESSION_ENABLED=1
